+// ---- TEMPORARY margin probe (spike 2026-09-07-native-ext-binary-stability) -------------------
+use std::cell::RefCell;
+pub struct TraceState {
+    pub target: i32,
+    pub path: Vec<i32>,
+    pub margins: Vec<(&'static str, f32)>,
+}
+thread_local! {
+    pub static TRACE: RefCell<Option<TraceState>> = const { RefCell::new(None) };
+}
+fn trace_on() -> bool {
+    TRACE.with(|t| t.borrow().is_some())
+}
+fn trace_push(label: &'static str, m: f32) -> usize {
+    TRACE.with(|t| {
+        let mut b = t.borrow_mut();
+        let s = b.as_mut().unwrap();
+        s.margins.push((label, m));
+        s.margins.len()
+    })
+}
+fn trace_truncate(n: usize) {
+    TRACE.with(|t| {
+        if let Some(s) = t.borrow_mut().as_mut() {
+            s.margins.truncate(n)
+        }
+    });
+}
+fn trace_try(light_idx: i32, from_leaf: i32, outcome: &str) {
+    TRACE.with(|t| {
+        let b = t.borrow();
+        let s = b.as_ref().unwrap();
+        let tight = s.margins.iter().map(|&(_, m)| m.abs()).fold(f32::INFINITY, f32::min);
+        eprintln!(
+            "PERMTRY leaf={} light={} from={} outcome={} path={:?} tightest={:e} margins={:?}",
+            s.target, light_idx, from_leaf, outcome, s.path, tight, s.margins
+        );
+    });
+}
+
+fn trace_report(light_idx: i32) {
+    TRACE.with(|t| {
+        let b = t.borrow();
+        let s = b.as_ref().unwrap();
+        let tight = s
+            .margins
+            .iter()
+            .map(|&(_, m)| m.abs())
+            .fold(f32::INFINITY, f32::min);
+        eprintln!(
+            "PERMMARGIN leaf={} light={} path={:?} tightest={:e} margins={:?}",
+            s.target, light_idx, s.path, tight, s.margins
+        );
+    });
+}
