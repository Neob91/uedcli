+pub(crate) static PROBE_WIND_OK: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) static PROBE_WIND_BAD: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);

