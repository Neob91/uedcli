#!/usr/bin/env bash
# uedcli — HOST-NATIVE dev launcher. Runs the uedcli CLI on the host in a Python 3.12 venv, so it
# has native access to asset dirs and reaches the docker daemon directly to drive the editor/game
# RUNTIME containers. Never provisions anything itself — run `old/bin/build` first (that's the
# only place needing Docker/network); this just checks what's already on disk and fails fast with
# a clear message if it isn't there. See bin/_venv.sh, dev/docs/dev-runtime.md.
#
# Put this dir on PATH (or symlink into ~/.local/bin), then: `uedcli level status`,
# `printf '%s' "$t3d" | uedcli actor add -`.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_venv.sh"
check_venv
check_native_ext
exec env PYTHONPATH="$UEDCLI_DIR" "$PY" -m uedcli "$@"
