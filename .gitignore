
uedcli/game/staging/

.venv/
__pycache__/
*.pyc
*.swp
_scratch/

# Feature worktrees live here — a worktree is a full second checkout, so leaving
# it visible would let `git add` stage a duplicate tree and would double every
# ripgrep hit and pytest collection. Precise, not blanket `.claude/`, so
# settings.json stays tracked. (dev/docs/rules/worktrees.md)
.claude/worktrees/

# Live, mutable manual-grading state for the geometry-eval reference page --
# reviewer scores/notes, not reference material.
dev/evals/grades/

# The working game copy `dev/scripts/install-deusex-assets.sh` assembles, plus its
# `.cache/<game>/{download,unpacked}` scratch. All COPYRIGHTED Deus Ex content and
# multi-gigabyte installer artifacts — user-supplied, never committed. Both the
# script and dev/docs/deusex-assets-setup.md state this is gitignored; until now
# nothing enforced it, so a `--url` run left `?? dev/games/` in the tracked tree.
dev/games/

# Per-machine project selection `dev/scripts/setup-game-preview.sh` writes at the repo root
# (`game = "<name>"` + local paths). Machine-local, not shared state — never committed.
/uedcli.toml

# UT99 build substrate the corpus toolchain compiles against — downloadable stock
# UnrealTournament GOTY binaries (~50MB of .u/.dll/UCC.exe/.int), fetched by
# uedcli/uscript/fetch_ut99.sh from archive.org. Reproducible, never committed.
uned/UT99/
uned/DXORIG/

# The full UT99 game asset substrate `dev/scripts/install-ut99-assets.sh` populates — same
# reasoning as uned/DeusExAssets (System/Textures/Sounds/Music/Maps content, multi-hundred-MB,
# user-supplied, reproducible from the script). Distinct from the narrower uned/UT99/ above (that
# one is just the uscript-compiler's UCC.exe + Core.u corpus). No trailing slash: a gitignore
# pattern ending in "/" matches only a real directory, not a symlink to one — and uned/DeusExAssets
# shows operators commonly point this kind of dir at a symlink instead.
uned/UT99Assets

# Same, for `dev/scripts/install-unreal-assets.sh` (original 1998/Gold Unreal).
uned/UnrealAssets
