#!/usr/bin/env bash
# bin/test — run uedcli's OFFLINE unit suite (pytest, HOST-NATIVE) + the Rust `cargo test` goldens
# (in a container — no host Rust needed). uedcli's own CLI runs host-native too (bin/uedcli); only the
# Rust build/test is containerized. Integration tests (-m integration) stay deselected by pytest.ini.
# Extra args pass straight through to pytest. Invoke path-qualified (`bin/test`) — `test` is a builtin.
#     bin/test                 # whole offline suite (pytest + cargo test)
#     bin/test -k texture -x   # extra args -> pytest
#     UEDCLI_SKIP_NATIVE=1 bin/test <file>   # pytest only (skip the Rust ext build + cargo test)
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_venv.sh"
ensure_venv
ensure_native_ext                      # builds uedcli_native (abi3 wheel) in a container, into the venv
cd "$UEDCLI_DIR"                       # pytest rootdir/testpaths resolve here

rc=0
if [ "$#" -eq 0 ]; then
  env PYTHONPATH="$UEDCLI_DIR" "$PY" -m pytest uedcli -q || rc=$?
else
  env PYTHONPATH="$UEDCLI_DIR" "$PY" -m pytest "$@" -q || rc=$?
fi

run_cargo_test || rc=$?                # Rust goldens, in the build container
exit "$rc"
