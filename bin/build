#!/usr/bin/env bash
# bin/build -- builds the new Rust uedcli skeleton inside the uedcli-rust-build Docker image (the
# same one old/bin/build already provisions, as a side effect of building old/'s native
# extension) -- no host Rust needed.
set -euo pipefail
NEW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$NEW_ROOT"

# Reuse old/'s own image-freshness check (content-hash label, rebuilds on Dockerfile change)
# rather than a bare existence check -- a stale image would otherwise build silently against an
# outdated toolchain instead of being caught. Sourcing this also redefines UEDCLI_DIR to old/'s
# own path (it's _venv.sh's own anchor) -- $NEW_ROOT is this script's separate name for the real
# repo root, used below, so that redefinition doesn't break anything here.
# shellcheck source=old/bin/_venv.sh
source "$NEW_ROOT/old/bin/_venv.sh"
_ensure_build_image \
  || { echo "bin/build: could not ensure the uedcli-rust-build image -- see the message above" >&2
       exit 1; }

# CARGO_HOME nested under target/ (already gitignored) rather than a new top-level dir -- same
# convention old/dev-container/build.Dockerfile uses for its own cargo registry cache.
docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -e CARGO_HOME=/io/target/.cargo-home \
  -v "$NEW_ROOT":/io -w /io \
  uedcli-rust-build cargo build >&2 \
  || { echo "bin/build: cargo build failed" >&2; exit 1; }

echo "bin/build: done -- binary at target/debug/uedcli" >&2
