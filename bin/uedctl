#!/usr/bin/env bash
# uedctl — HOST-NATIVE dev launcher. Runs the uedctl CLI on the host in a Python
# 3.12 venv (mirroring the eventual Nuitka release binary), with native access to
# asset dirs and no dev-container path/mount juggling. Editor/build containers it
# drives still run via docker. See bin/_venv.sh + dev/docs/dev-runtime.md.
#
# Put this dir on PATH (or symlink into ~/.local/bin), then: `uedctl level status`,
# `printf '%s' "$t3d" | uedctl actor add -`. The venv auto-creates on first run;
# `UEDCTL_VENV_REBUILD=1 uedctl …` forces a dep refresh.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_venv.sh"
ensure_venv
exec env PYTHONPATH="$UEDCTL_DIR" "$PY" -m uedctl "$@"
